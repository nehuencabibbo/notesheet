{
  "manifest_version": 3,
  "name": "Notesheet Cantrill Capture",
  "version": "1.1.0",
  "description": "Hide the embedded video controls on learn.cantrill.io before capturing with Notesheet.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://learn.cantrill.io/*",
    "https://player.hotmart.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.cantrill.io/*",
        "https://player.hotmart.com/*"
      ],
      "js": ["cantrill-capture.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
