{
  "manifest_version": 3,
  "name": "Notesheet Hotmart Capture",
  "version": "1.0.0",
  "description": "Hide Hotmart video controls before capturing with Notesheet.",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://hotmart.com/*",
    "https://*.hotmart.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hotmart.com/*",
        "https://*.hotmart.com/*"
      ],
      "js": ["hotmart-capture.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
